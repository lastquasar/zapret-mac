+#ifdef __APPLE__
+#include <net/if.h>
+#include <stdlib.h>
+
+// zapret-mac: pin outgoing sockets to the physical interface named in
+// CIADPI_BOUND_IF, so they do not loop back into the TUN device.
+static int bind_to_iface(int fd)
+{
+    static int init = 0;
+    static unsigned int idx = 0;
+    if (!init) {
+        init = 1;
+        const char *name = getenv("CIADPI_BOUND_IF");
+        if (name && *name) {
+            idx = if_nametoindex(name);
+        }
+    }
+    if (!idx) {
+        return 0;
+    }
+    union sockaddr_u addr;
+    socklen_t sz = sizeof(addr);
+    if (getsockname(fd, &addr.sa, &sz)) {
+        uniperror("getsockname");
+        return -1;
+    }
+    int r = addr.sa.sa_family == AF_INET6
+        ? setsockopt(fd, IPPROTO_IPV6, IPV6_BOUND_IF, &idx, sizeof(idx))
+        : setsockopt(fd, IPPROTO_IP, IP_BOUND_IF, &idx, sizeof(idx));
+    if (r) {
+        uniperror("setsockopt BOUND_IF");
+        return -1;
+    }
+    return 0;
+}
+#endif
+
